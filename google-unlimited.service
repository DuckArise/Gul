[Unit]
Description=Google Photos Unlimited Auto-Sync Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/GoogleUnlimited
ExecStart=%h/GoogleUnlimited/watch_and_upload.sh
Restart=on-failure
RestartSec=10
KillMode=mixed

[Install]
WantedBy=default.target
